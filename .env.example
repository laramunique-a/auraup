# Variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env.local e preencha os valores do Supabase quando migrar

# Modo local (sem Supabase) — deixe como 'true' para rodar sem backend
VITE_LOCAL_MODE=true

# Supabase (preencher quando migrar)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
